# Email Configuration
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-password-or-app-password
EMAIL_PROTOCOL=IMAP

# IMAP Configuration (used when EMAIL_PROTOCOL=IMAP)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# SMTP Configuration (used when EMAIL_PROTOCOL=IMAP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Exchange Configuration (used when EMAIL_PROTOCOL=EXCHANGE)
EXCHANGE_SERVER=outlook.office365.com
EXCHANGE_VERSION=Office365
EXCHANGE_EMAIL=your-email@example.com
EXCHANGE_USERNAME=
EXCHANGE_AUTODISCOVER=true

# LLM Configuration (Ollama)
LLM_ENDPOINT=http://localhost:11434/api/generate
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.15
LLM_MAX_EVENTS_PER_EMAIL=5

RESULTS_DB_PATH=data/processed_results.db
AUTO_APPROVE_EVENTS=false
ENABLE_DEBUG_DUMPS=false
LLM_DEBUG_DIR=

# Attachment text extraction (enabled by default, can also be toggled in Web UI)
ATTACHMENT_PARSING_ENABLED=true
ATTACHMENT_MAX_FILES_PER_EMAIL=5
ATTACHMENT_MAX_FILE_SIZE_BYTES=5242880
ATTACHMENT_MAX_TEXT_CHARS=12000
ATTACHMENT_MAX_PDF_PAGES=20

# Processing Configuration
CHECK_INTERVAL_SECONDS=300
MAX_EMAILS_PER_CHECK=10

# Calendar Configuration
DEFAULT_TIMEZONE=Europe/Berlin
ORGANIZER_NAME=iCal Bot
# ORGANIZER_EMAIL=optional-alias@example.com
INTERNAL_EMAIL_DOMAIN=example.com

# Testing & Monitoring
DRY_RUN=false

# Web UI
WEB_UI_ENABLED=true
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=5000
# REQUIRE_HTTPS_FOR_REMOTE=true
# REQUIRE_HTTPS_FOR_LLM=true
# Web UI auth storage
# UI_AUTH_STORE_PATH=data/ui_auth.json
# UI_AUTH_SECRET_PATH=data/ui_auth_secret.key
